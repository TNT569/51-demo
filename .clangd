CompileFlags:
  Add:
    - -isystem/usr/share/sdcc/include
    - -isystem/usr/share/sdcc/include/mcs51
    - -D__SDCC=1
    - -D__SDCC_VERSION_MAJOR=4
    - -D__SDCC_VERSION_MINOR=2
    - -D__SDCC_VERSION_PATCH=0
    - -D__SDCC_mcs51=1
    - -ferror-limit=0
  Remove:
    - --cpu
    - --li
    - --c99
    - --std-c99
    - -mmcs51
    - --opt-code-speed
    - --xram-size
    - --iram-size
    - --code-size
    - --std-c23
    - --split_sections
    - --diag_suppress=*
    - --no_depend_system_headers
    - --depend
    - --strict
    - --enum_is_int
    - --gnu
    - --apcs=*
    - --signed_chars
    - --split_ldm
    - --execute_only
    - -Otime
  CompilationDatabase: ./build/Debug
Diagnostics:
  Suppress: "*"
